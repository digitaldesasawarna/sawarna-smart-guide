# ========================================================
# SAWARNA SMART GUIDE - .gitignore
# Hanya berkas web app utama yang diunggah ke GitHub
# ========================================================

# --- Dokumentasi Internal & PRD ---
# Menjaga dokumen perencanaan, PRD, dan catatan survei tetap privat di lokal
docs/
*PRD*
*prd*
*.draft.md
catatan/
notes/

# --- File Referensi Desain & Mockup Kasar ---
# Contoh gambar/acuan eksternal agar tidak mengotori repositori publik
Contoh*
contoh*
reference/
references/
*.tmp

# --- Agent Customizations & Tooling ---
# Skills, prompts, dan konfigurasi agen AI khusus lingkungan lokal IDE
.agents/
.agent/
_agents/
_agent/
skills-lock.json
.claude/
.cursor/

# --- File Sistem Operasi ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editor & IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Konfigurasi Lokal & Environment ---
.env
.env.*
!.env.example
*.local

# --- Build, Cache, & Dependencies (Jika menggunakan tooling di masa mendatang) ---
node_modules/
dist/
build/
__pycache__/
*.py[cod]
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Tile Pyramid (besar, di-generate lokal — tidak perlu commit) ---
# Tiles di-generate via: node gen_tiles.mjs
# Tambahkan `!assets/maps/tiles` untuk commit tiles ke repo jika diperlukan
# assets/maps/tiles/

# --- Script Generator (hanya dibutuhkan developer, bukan end-user) ---
gen_tiles.mjs
package.json
package-lock.json
